# Скопируйте в .env и заполните секреты: cp .env.example .env
#
# Безопасность: не коммитьте .env, не выкладывайте его в открытые репозитории, облачные папки
# и публичные чаты. В Git — только этот файл-шаблон; реальные ключи храните в .env (он в .gitignore).
#
# Пути ниже — относительно корня проекта (рядом с main.py), не зависят от cwd systemd/docker.
# На VPS замените на абсолютные каталоги на постоянном диске (один раз создайте тома/папки).

# VPS только под сайт/оплату/ключи — без Playwright в облаке (десктопы с локальным бэкендом):
# FB_MASTER_DISABLE_PLAYWRIGHT_WORKERS=1
#
# На VPS: Chromium для Playwright (парсер, «Войти в Facebook», рассылка). Без переменной браузер ищется в
# ~/.cache/ms-playwright у пользователя сервиса (часто /home/fbmaster/...). После bootstrap с INSTALL_PLAYWRIGHT=1
# путь добавляется автоматически; вручную, если ставили chromium в каталог проекта:
# PLAYWRIGHT_BROWSERS_PATH=/opt/fb-master/playwright-browsers
#
# Локальный бэкенд в Electron: активация ключа запросом на этот домен (https без слэша):
# FB_MASTER_LICENSE_API_BASE=https://socmaster.pro

# ── Сервер приложения ───────────────────────────────
APP_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-to-long-random-string
BO_HOST=127.0.0.1
BO_PORT=8000

# Скрыть кнопку «Выйти» в сайдбаре (лаунчер десктопа подставляет сам; на VPS обычно не задают).
# FB_MASTER_HIDE_LOGOUT=true

# «Система → Настройки»: скрыть у клиента блоки Supabase Auth, прямой Google OAuth/allowlist, пути к данным (и строки «Пути/OAuth из .env» в диагностике).
# Лаунчер Electron включает сам (FB_MASTER_HIDE_INFRA_SETTINGS=1). На VPS не задавайте — нужен полный экран настроек. Отладка десктопа: FB_MASTER_HIDE_INFRA_SETTINGS=0
# FB_MASTER_HIDE_INFRA_SETTINGS=true

# Локально без OAuth: автоматический вход (оператор operator@fb-master.local). Не включать на публичном VPS.
# FB_MASTER_NO_AUTH=true

# Ключ доступа перед кабинетом: сначала создайте ключ (Платформа → ключи или python scripts/create_access_key.py), затем включайте.
# FB_MASTER_ACCESS_KEY_REQUIRED=true
# После валидного ключа — автоматический оператор без OAuth (десктопный лаунчер подставляет сам; на публичном VPS обычно не включают).
# FB_MASTER_OPERATOR_AFTER_ACCESS_KEY=true

# Слушать все интерфейсы (типично для VPS): раскомментируйте
# BO_HOST=0.0.0.0

# Публичный URL для Google OAuth за nginx/HTTPS (без слэша в конце). Локально можно не задавать.
# OAUTH_REDIRECT_BASE=https://ваш-домен.ru

# Веб-вход в кабинет только после секретного URL и пароля (прямой /auth/login в браузере — 404).
# Откройте: https://ваш-домен/gate/<slug> → введите пароль → далее экран входа (Google/Supabase) или только ключ (см. флаг ниже).
# Десктоп Electron (User-Agent …FBMasterDesktop…) не блокируется — локальный кабинет на 127.0.0.1 не затрагивается.
# FB_MASTER_WEB_CABINET_GATE_SLUG=случайная-длинная-строка-без-слэшей
# FB_MASTER_WEB_CABINET_GATE_PASSWORD=ваш-секрет
#
# Убрать Google/Supabase/email/Developer с сайта: только оплаченный ключ на /auth/unlock (рекомендуется с FB_MASTER_ACCESS_KEY_REQUIRED=true).
# При включённом gate обычный браузер не откроет /auth/unlock без пароля на /gate/<slug>. Раздел «Платформа» в веб без OAuth недоступен.
# FB_MASTER_WEB_CABINET_EMAIL_LOGIN_DISABLED=true

# ── Каталоги (создаются автоматически при старте) ───
DATA_DIR=data
BROWSER_PROFILES_DIR=browser_profiles
BASE_FB_DIR=Base FB

# Пример для Linux-сервера с отдельным томом:
# DATA_DIR=/var/lib/fb-master/data
# BROWSER_PROFILES_DIR=/var/lib/fb-master/browser_profiles
# BASE_FB_DIR=/var/lib/fb-master/Base FB

# Логи: всегда внутри DATA_DIR → data/logs/

# ── Supabase Auth (рекомендуемый вход: Google без redirect на каждый IP) ──
# Dashboard → Settings → API: Project URL и anon public key.
# Кабинет: «Система → Настройки» → блок Supabase Auth.
# Supabase → Authentication → Providers → Google + URL Configuration → Redirect URLs
#   (добавьте http://127.0.0.1:8000/auth/supabase/callback и прод-домен с тем же путём).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# ── Google OAuth 2.0 (прямой вход, только если Supabase не используете) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAILS=

# ── Локально «как на сервере» ────────────────────────
# LOCAL_SIMULATE_PRODUCTION=true
#   → выключает «Войти как Developer», принудительно headless, без cookies из Chrome.
# DISABLE_DEV_LOGIN=true  — только запрет dev-login, без остального.
# SESSION_COOKIE_SECURE=true  — cookie сессии только по HTTPS (за nginx TLS).

# Владелец платформы: через запятую. Только эти email видят в сайдбаре блок «Платформа → Админ»
# и страницу /admin/platform (остальные получают 404 на этот URL).
# Пример:
# FB_MASTER_OWNER_EMAILS=sima860207@gmail.com

# Админ-панель: таблица «Клиентские машины» (пульс с копий программы в общую БД)
# FBM_CLIENT_PRESENCE_INTERVAL_SEC=45
# FBM_CLIENT_ONLINE_THRESHOLD_SEC=120
# Десктоп (SQLite) шлёт пульс на VPS: по умолчанию FB_MASTER_LICENSE_API_BASE + /api/public/client-presence
# FB_MASTER_PRESENCE_REPORT_URL=https://ваш-домен.ru/api/public/client-presence

# ── LLM (AI-агент) ──────────────────────────────────
# Ключ с platform.openai.com — обычно sk-... или sk-proj-... (не k-proj-).
OPENAI_API_KEY=
GOOGLE_API_KEY=
#
# Локальная нейросеть (без облачных ключей): URL сервера и имя модели задаются в кабинете —
# раздел «ИИ-агент». Типичный адрес на этой машине: http://127.0.0.1:11434 (если не меняли).

# ── Логирование ─────────────────────────────────────
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=14
LOG_LLM_DEBUG=false

# Прогрев, парсер друзей, сценарии, мессенджер: headless Chromium (true = без окна; false = видимый браузер)
WARMUP_HEADLESS=true
# Messenger: ожидание ввода PIN / разблокировки E2EE (секунды). 0 — не ждать. На проде часто 600–1800.
MESSENGER_E2EE_WAIT_SECONDS=600
# Опционально: PIN E2EE Messenger — Playwright будет пытаться подставить в окно (хрупко к вёрстке FB; храните .env в секрете)
# MESSENGER_E2EE_PIN=

# Сценарии по дням (IANA)
SEQUENCE_TIMEZONE=Europe/Madrid

# Локально (macOS): при «Войти в Facebook» и проверке сессии подставлять cookies из Google Chrome.
# Перед этим полностью закройте Chrome (Cmd+Q). На VPS = false.
FB_LOCAL_CHROME_COOKIES=false

# Опционально: Playwright подключается по CDP к УЖЕ запущенному Chromium (антидетект / Chrome с remote debugging).
# Тогда «Войти в Facebook», автологин и проверка сессии используют этот браузер; прокси и fingerprint — в его профиле.
# Пример: http://127.0.0.1:9222  (или ws://… из curl http://127.0.0.1:9222/json/version → webSocketDebuggerUrl)
# Перекрывается, если у конкретного FB-аккаунта в кабинете заполнено поле «CDP».
# FB_CDP_ENDPOINT=http://127.0.0.1:9222

# Stealth Shell: расширенная JS-инъекция отпечатка + флаги Chromium (0 = только минимальный webdriver/chrome)
# FB_STEALTH_ENGINE=1
# Бинарь для stealth_engine/launch_stealth_chromium.py если не найден в PATH / Applications
# FB_STEALTH_CHROME_BINARY=

# ── База данных (по умолчанию SQLite: data/app.db) ───
#
# Supabase (PostgreSQL): Dashboard → Connect → строка «URI».
# Поддерживаются DATABASE_URL или SUPABASE_DATABASE_URL (достаточно одной).
# Формат postgresql:// или postgres:// — в коде подставится драйвер psycopg v3.
#
# Режимы (см. https://supabase.com/docs/guides/database/connecting-to-postgres ):
# - Direct: db.<ref>.supabase.co:5432 — часто только IPv6; для VPS без IPv6 не подойдёт.
# - Pooler Session (IPv4/IPv6): aws-0-<region>.pooler.supabase.com:5432, пользователь postgres.<ref>
# - Pooler Transaction (serverless / порт 6543): в т.ч. db.<ref>.supabase.co:6543 —
#   prepared statements отключаются автоматически (prepare_threshold=None).
#
# Спецсимволы в пароле — URL-encode (@ → %40 и т.д.).
#
# DATABASE_URL=postgresql://postgres:ВАШ_ПАРОЛЬ@db.xxxxx.supabase.co:5432/postgres
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxxx:ВАШ_ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# DATABASE_SSL_REQUIRE=true          # внешний Postgres с SSL, если хост не *.supabase.*
# DATABASE_DISABLE_PREPARED_STATEMENTS=true  # если pooler без prepared, а порт не 6543
# DB_CONNECT_TIMEOUT=15              # сек.; для Supabase по умолчанию 15, если не задано
# DB_CONNECT_TIMEOUT_SUPABASE=15     # только для хостов supabase (если не задан DB_CONNECT_TIMEOUT)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# На малых тарифах Supabase уменьшите пул, чтобы не упираться в лимит соединений, например:
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
#
# Проверка строки перед деплоем: python3 scripts/check_database_connection.py

# ── Централизованные обновления настольного приложения (Electron) ─────────
# Клиент с FB_MASTER_APP_URL на этот сервер запрашивает GET /api/public/desktop-update
# и при большей latest_version показывает диалог со ссылкой на установщик.
# Версия в desktop/fb-master-desktop/package.json должна быть меньше или равна latest при отсутствии обновления.
# Формат версий продукта: «2.14», «2.15» (без обязательного третьего сегмента .0).
#
# Страница /buy: для Mac Apple Silicon (M) — архив .zip (DMG + HTML-инструкция первого запуска):
#   ./scripts/zip-mac-arm64-bundle.sh ВЕРСИЯ
# Скрипт кладёт в static/releases: FbMaster-ВЕРСИЯ-mac-arm64-bundle.zip и копию .dmg (для второй ссылки на /buy).
# Достаточно выставить ту же версию, что в package.json, и залить static/releases на сервер:
# FB_DESKTOP_LATEST_VERSION=2.14
# Тогда ссылки на .zip и .dmg на /buy подставятся сами (APP_BASE_URL = публичный https-домен).
# Явный URL при необходимости: FB_DESKTOP_DOWNLOAD_DARWIN_ARM64_BUNDLE=...
# Работа приложения без ключа — блокируется десктопом. Intel/Win на /buy не выводятся.
# Явный URL страницы «скачать и материалы» (по умолчанию …/buy):
# FB_MASTER_MARKETING_BUY_URL=https://socmaster.pro/buy
# URL только оплаты для ссылки «Нет ключа?» в приложении (по умолчанию …/purchase):
# FB_MASTER_MARKETING_PURCHASE_URL=https://socmaster.pro/purchase
#
# FB_DESKTOP_LATEST_VERSION=2.14
# FB_DESKTOP_MIN_VERSION=2.0
# FB_DESKTOP_RELEASE_NOTES=2.14: кратко что нового для пользователей десктопа.
# Либо общие URL, либо отдельно ARM64 / Intel Mac (имена из electron-builder artifactName):
# FB_DESKTOP_DOWNLOAD_DARWIN_ARM64=https://socmaster.pro/static/releases/FbMaster-2.14-mac-arm64.dmg
# FB_DESKTOP_DOWNLOAD_DARWIN_X64=https://socmaster.pro/static/releases/FbMaster-1.0.4-mac-x64.dmg
# FB_DESKTOP_DOWNLOAD_WIN32_X64=https://socmaster.pro/static/releases/FbMaster-1.0.4-win-x64.exe
# FB_DESKTOP_DOWNLOAD_MAC=https://ваш-домен/static/releases/FbMaster-2.14-mac-arm64.dmg
# FB_DESKTOP_DOWNLOAD_WIN=https://ваш-домен/static/releases/FbMaster-1.0.4-win-x64.exe
# FB_DESKTOP_DOWNLOAD_LINUX=
# FB_DESKTOP_DOWNLOAD_DARWIN_X64=  # Intel Mac, если отдельный билд
# Архив для клиентов после оплаты (scripts/zip-mac-arm64-bundle.sh): .zip = .dmg + HTML-инструкция
# FB_DESKTOP_DOWNLOAD_DARWIN_ARM64_BUNDLE=https://socmaster.pro/static/releases/FbMaster-2.14-mac-arm64-bundle.zip
#
# Защита от прямого скачивания /static/releases/*.dmg без ссылки:
# В .env: FB_BLOCK_STATIC_RELEASES=true
# В nginx подключите фрагмент deploy/nginx-block-static-releases.conf.example
# Ссылки в ответах API и после оплаты подменяются на подписанные /download/release?... (FB_RELEASE_SIGNED_URLS=true по умолчанию).
# FB_RELEASE_TTL_PAID_SECONDS=172800
# FB_RELEASE_TTL_MANIFEST_SECONDS=604800

# ── NOWPayments (автопродление ключа на /auth/unlock) ───────────────────────
# Кабинет: https://account.nowpayments.io — API Key, IPN Secret.
# IPN callback URL в кабинете NP: https://ВАШ_ДОМЕН/webhooks/nowpayments (на проде только HTTPS).
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_SANDBOX=true
# NOWPAYMENTS_PRICE_USD_30=29
# NOWPAYMENTS_PRICE_USD_90=79
# NOWPAYMENTS_PRICE_USD_180=149
# NOWPAYMENTS_PRICE_USD_365=249
# Тестовый тариф (показывается в списке только если включён флаг):
# NOWPAYMENTS_TEST_TARIFF_ENABLED=true
# NOWPAYMENTS_PRICE_USD_TEST=10
# NOWPAYMENTS_TEST_DURATION_MINUTES=3

# ═══ Прод: VPS + Supabase (кратко) ═══════════════════════════════════════════
# Чеклист: deploy/YOU_DO_MANUALLY.md; пример .env: deploy/vps-supabase.env.example
#
# APP_BASE_URL=https://fb.ваш-домен.ru
# OAUTH_REDIRECT_BASE=https://fb.ваш-домен.ru
# BO_HOST=127.0.0.1
# SESSION_COOKIE_SECURE=true
# DATABASE_URL=postgresql://postgres.REF:ПАРОЛЬ@aws-0-РЕГИОН.pooler.supabase.com:6543/postgres
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# FB_MASTER_OWNER_EMAILS=ваш@gmail.com
# FB_MASTER_ACCESS_KEY_REQUIRED=true
# DATA_DIR=/var/lib/fb-master/data
# BROWSER_PROFILES_DIR=/var/lib/fb-master/browser_profiles
# BASE_FB_DIR=/var/lib/fb-master/Base FB

# ═══ LavaTop (карты RU/EU/СНГ + recurring подписки, физлицу OK) ═════════════
# Кабинет: https://app.lava.top/integrations/public-api
#   1) Создайте API key → значение ниже
#   2) Добавьте 2 webhook'а с одинаковым URL https://ВАШ_ДОМЕН/webhooks/lavatop:
#      - Тип: «Результат платежа», Auth: Basic (login + password) — ниже
#      - Тип: «Регулярный платёж», Auth: Basic (тот же login + password)
#   3) Создайте 4 подписки в кабинете (на 30/90/180/365 дней) — это создаст
#      один общий продукт (LAVATOP_PRODUCT_ID) и 4 offer'а (LAVATOP_OFFER_ID_*).
# LAVATOP_API_KEY=lava_xxxxxxxxxxxxxxxxxxxxxxx
# LAVATOP_API_BASE=https://gate.lava.top
# LAVATOP_WEBHOOK_LOGIN=socmaster_lavatop
# LAVATOP_WEBHOOK_PASSWORD=ЗАМЕНИТЕ_НА_СВОЙ_СЛОЖНЫЙ_ПАРОЛЬ_32+_СИМВОЛОВ
# LAVATOP_RECURRING_DEFAULT=true
# LAVATOP_PRODUCT_ID=00000000-0000-0000-0000-000000000000
# LAVATOP_OFFER_ID_30=00000000-0000-0000-0000-000000000000
# LAVATOP_OFFER_ID_90=00000000-0000-0000-0000-000000000000
# LAVATOP_OFFER_ID_180=00000000-0000-0000-0000-000000000000
# LAVATOP_OFFER_ID_365=00000000-0000-0000-0000-000000000000
# Цены в USD (должны совпадать с настройками в кабинете LavaTop):
# LAVATOP_PRICE_USD_30=100
# LAVATOP_PRICE_USD_90=270
# LAVATOP_PRICE_USD_180=499
# LAVATOP_PRICE_USD_365=865

# ═══ Brevo (email-сервис, 300 писем/день навсегда бесплатно) ════════════════
# https://app.brevo.com/settings/keys/api — создать API key (без галочки MCP).
# Перед использованием подтвердите Sender (домен или email) в Brevo:
#   https://app.brevo.com/senders → Add a sender / Authenticate domain
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_FROM_EMAIL=keys@ваш-домен.ru
# BREVO_FROM_NAME=SOCMASTER

# ═══ Mailgun (DEPRECATED — заменён Brevo, оставлен как fallback) ═══════════
# Если Brevo выключен (BREVO_API_KEY пустой), email-сервис попробует Mailgun.
# Новые установки: используйте Brevo выше; этот блок можно не заполнять.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.ваш-домен.ru
# MAILGUN_FROM_EMAIL=keys@ваш-домен.ru
# MAILGUN_FROM_NAME=SOCMASTER
# MAILGUN_REGION=us
