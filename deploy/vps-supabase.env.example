# Пример .env на VPS с базой Supabase (PostgreSQL).
# Скопируйте в /opt/fb-master/.env и подставьте свои значения.
# Чеклист ручных шагов: deploy/YOU_DO_MANUALLY.md

APP_BASE_URL=https://ВАШ_ДОМЕН
OAUTH_REDIRECT_BASE=https://ВАШ_ДОМЕН
SECRET_KEY=сгенерируйте-длинную-случайную-строку

BO_HOST=127.0.0.1
BO_PORT=8000
SESSION_COOKIE_SECURE=true

# Supabase → Project Settings → Database → Connection string → URI
# На VPS без IPv6 к direct db.*.supabase.co:5432 часто не подключиться — Session pooler или Transaction (порт 6543).
# Пример transaction pooler (подставьте пароль, регион, ref):
# DATABASE_URL=postgresql://postgres.ВАШ_REF:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Supabase → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Владелец платформы (доступ к /admin/platform и ключам)
FB_MASTER_OWNER_EMAILS=ваш@email.com

# После создания ключей в админке
# FB_MASTER_ACCESS_KEY_REQUIRED=true
#
# Обязательно для клиентов: только ключ (без экрана Google/email/Developer). Иначе после активации ключа откроется /auth/login.
# FB_MASTER_WEB_CABINET_EMAIL_LOGIN_DISABLED=1

# NOWPayments — продление ключа с экрана /auth/unlock (см. .env.example)
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_SANDBOX=false
# NOWPAYMENTS_TEST_TARIFF_ENABLED=true
# NOWPAYMENTS_PRICE_USD_TEST=10
# NOWPAYMENTS_TEST_DURATION_MINUTES=3

# Десктопы с локальным бэкендом: на VPS не запускать Playwright-воркеры (только сайт, оплата, API ключа)
# FB_MASTER_DISABLE_PLAYWRIGHT_WORKERS=1
#
# Опционально: обновления Electron-дистрибутива (версия = package.json десктопа)
# FB_DESKTOP_LATEST_VERSION=1.2.1
# FB_DESKTOP_RELEASE_NOTES=1.2.1: кабинет на сервере; ключи ИИ; сессия; Chromium; версия в кабинете.
# FB_DESKTOP_DOWNLOAD_DARWIN_ARM64=https://ВАШ_ДОМЕН/static/releases/FbMaster-1.2.1-mac-arm64.dmg
# FB_DESKTOP_DOWNLOAD_DARWIN_X64=https://ВАШ_ДОМЕН/static/releases/FbMaster-1.0.4-mac-x64.dmg
# FB_DESKTOP_DOWNLOAD_WIN32_X64=https://ВАШ_ДОМЕН/static/releases/FbMaster-1.0.4-win-x64.exe

# Каталоги на постоянном диске (создайте и выдайте права пользователю сервиса)
DATA_DIR=/var/lib/fb-master/data
BROWSER_PROFILES_DIR=/var/lib/fb-master/browser_profiles
BASE_FB_DIR=/var/lib/fb-master/Base FB
