# Скопируйте в /etc/systemd/system/fb-master.service (пути и пользователь — под себя).
# sudo systemctl daemon-reload && sudo systemctl enable --now fb-master

[Unit]
Description=FB Master back-office (uvicorn)
After=network.target

[Service]
Type=simple
User=fbmaster
Group=fbmaster
WorkingDirectory=/opt/fb-master
EnvironmentFile=/opt/fb-master/.env
ExecStart=/opt/fb-master/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=on-failure
RestartSec=5

# Playwright/Chromium на сервере (парсер, мессенджер) — при необходимости увеличьте лимиты
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
