# Подключите в server { ... } для socmaster.pro ПОСЛЕ location / и ПЕРЕД прокси на uvicorn.
# Прямой URL вида https://домен/static/releases/*.dmg перестанет отдавать файлы —
# скачивание только через подписанные ссылки /download/release?f=...&exp=...&sig=...
#
# В .env приложения задайте:
#   FB_BLOCK_STATIC_RELEASES=true
#   FB_RELEASE_SIGNED_URLS=true   (по умолчанию уже true)
# SECRET_KEY на сервере должен совпадать с тем, что использовался при подписи ссылок в JSON.

location ^~ /static/releases/ {
    deny all;
    return 404;
}
